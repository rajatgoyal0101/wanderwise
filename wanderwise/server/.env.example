# Copy this file to `.env` and fill in your real values.
# Never commit `.env`.

# Pick ONE provider. If both are set, GROQ wins.

# ── Groq (recommended — free, no credit card, generous limits) ──
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional: override the model. Default is llama-3.3-70b-versatile.
# GROQ_MODEL=llama-3.3-70b-versatile

# ── Gemini (free tier requires billing-on-file in some regions) ──
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Port for the Express server (default 3000)
PORT=3000
